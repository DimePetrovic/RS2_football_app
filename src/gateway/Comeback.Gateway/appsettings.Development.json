{
  "Logging": {
    "LogLevel": {
      "Default": "Debug",
      "Microsoft.AspNetCore": "Information"
    }
  },
  "Seq": {
    "ServerUrl": "http://localhost:5341"
  },
  "Services": {
    "AuthApi": "http://localhost:5104",
    "ProfileApi": "http://localhost:5210",
    "RatingApi": "http://localhost:5310"
  },
  "ReverseProxy": {
    "Clusters": {
      "auth-cluster": {
        "Destinations": {
          "auth-api": { "Address": "http://localhost:5104" }
        }
      },
      "profile-cluster": {
        "Destinations": {
          "profile-api": { "Address": "http://localhost:5210" }
        }
      },
      "rating-cluster": {
        "Destinations": {
          "rating-api": { "Address": "http://localhost:5310" }
        }
      }
    }
  }
}
