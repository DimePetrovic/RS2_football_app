{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Yarp": "Warning"
    }
  },
  "AllowedHosts": "*",
  "Cors": {
    "AllowedOrigins": [ "http://localhost:4200" ]
  },
  "JwtSettings": {
    "Secret": "dev-secret-min-32-chars-comeback-auth-2026",
    "Issuer": "comeback-auth",
    "Audience": "comeback-api"
  },
  "Seq": {
    "ServerUrl": "http://seq:5341"
  },
  "Services": {
    "AuthApi": "http://auth-api:8080",
    "ProfileApi": "http://profile-api:8080",
    "RatingApi": "http://rating-api:8080",
    "MatchApi": "http://match-api:8080",
    "NotificationApi": "http://notification-api:8080",
    "ChatApi": "http://chat-api:8080",
    "SocialApi": "http://social-api:8080"
  },
  "ReverseProxy": {
    "Routes": {
      "auth-route": {
        "ClusterId": "auth-cluster",
        "Match": { "Path": "/api/auth/{**catch-all}" }
      },
      "profiles-route": {
        "ClusterId": "profile-cluster",
        "Match": { "Path": "/api/profiles/{**catch-all}" }
      },
      "groups-route": {
        "ClusterId": "profile-cluster",
        "Match": { "Path": "/api/groups/{**catch-all}" }
      },
      "rating-route": {
        "ClusterId": "rating-cluster",
        "Match": { "Path": "/api/rating/{**catch-all}" }
      },
      "matches-route": {
        "ClusterId": "match-cluster",
        "Match": { "Path": "/api/matches/{**catch-all}" }
      },
      "notifications-route": {
        "ClusterId": "notification-cluster",
        "Match": { "Path": "/api/notifications/{**catch-all}" }
      },
      "chat-route": {
        "ClusterId": "chat-cluster",
        "Match": { "Path": "/api/chat/{**catch-all}" }
      },
      "chat-hub-route": {
        "ClusterId": "chat-cluster",
        "Match": { "Path": "/hubs/chat/{**rest}" }
      },
      "notifications-hub-route": {
        "ClusterId": "notification-cluster",
        "Match": { "Path": "/hubs/notifications/{**rest}" }
      },
      "feed-route": {
        "ClusterId": "social-cluster",
        "Match": { "Path": "/api/feed/{**catch-all}" }
      },
      "posts-route": {
        "ClusterId": "social-cluster",
        "Match": { "Path": "/api/posts/{**catch-all}" }
      }
    },
    "Clusters": {
      "auth-cluster": {
        "Destinations": {
          "auth-api": { "Address": "http://auth-api:8080" }
        }
      },
      "profile-cluster": {
        "Destinations": {
          "profile-api": { "Address": "http://profile-api:8080" }
        }
      },
      "rating-cluster": {
        "Destinations": {
          "rating-api": { "Address": "http://rating-api:8080" }
        }
      },
      "match-cluster": {
        "Destinations": {
          "match-api": { "Address": "http://match-api:8080" }
        }
      },
      "notification-cluster": {
        "Destinations": {
          "notification-api": { "Address": "http://notification-api:8080" }
        }
      },
      "chat-cluster": {
        "Destinations": {
          "chat-api": { "Address": "http://chat-api:8080" }
        }
      },
      "social-cluster": {
        "Destinations": {
          "social-api": { "Address": "http://social-api:8080" }
        }
      }
    }
  }
}
