# Globalna podešavanja — email za Let's Encrypt (ACME)
{
	email {$ACME_EMAIL}
}

# {$DOMAIN} se popunjava iz env varijable (npr. comeback.example.com)
{$DOMAIN} {
	encode zstd gzip

	# API i SignalR hub-ovi idu na gateway (prefiks se NE skida — YARP ga očekuje).
	# Caddy automatski radi WebSocket upgrade za /hubs (chat + notifikacije uživo).
	@backend path /api/* /hubs/*
	reverse_proxy @backend gateway:8080

	# Sve ostalo je Angular SPA (deep-linkovi vraćaju index.html)
	handle {
		root * /srv
		try_files {path} /index.html
		file_server
	}
}
