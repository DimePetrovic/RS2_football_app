# Kopiraj u .env (docker compose ga automatski učitava iz ovog foldera).

# Cloudinary nalog (Dashboard → Settings → API Keys)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Opciono — podrazumevane dev vrednosti postoje u docker-compose.yml
# POSTGRES_PASSWORD=
# JWT_SECRET=
# RABBITMQ_PASSWORD=
