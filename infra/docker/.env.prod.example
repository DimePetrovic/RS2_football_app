# ─────────────────────────────────────────────────────────────
# Kopiraj u `.env.prod` na serveru i popuni PRAVIM vrednostima.
# NE commituj .env.prod (već je pokriven .gitignore-om ".env*").
# Jake tajne generiši sa:  openssl rand -base64 32
# ─────────────────────────────────────────────────────────────

# Domen (bez https://) i email za Let's Encrypt sertifikat
DOMAIN=comeback.example.com
ACME_EMAIL=ti@example.com

# Baze i broker (ista lozinka za sve Postgres instance)
POSTGRES_PASSWORD=__promeni_me__
RABBITMQ_PASSWORD=__promeni_me__

# JWT potpis (min 32 karaktera!) i ključ za enkripciju chata (base64, 32 bajta)
JWT_SECRET=__promeni_me_min_32_karaktera__
CHAT_ENCRYPTION_KEY=__base64_32_bajta__

# Seq admin lozinka (logovi)
SEQ_ADMIN_PASSWORD=__promeni_me__

# Cloudinary (upload slika) — iz Cloudinary dashboarda
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# SMTP — Brevo (https://app.brevo.com → SMTP & API → SMTP)
SMTP_HOST=smtp-relay.brevo.com
SMTP_PORT=587
SMTP_ENABLE_SSL=true
SMTP_USERNAME=__tvoj_brevo_login__
SMTP_PASSWORD=__brevo_smtp_key__
SMTP_FROM_EMAIL=noreply@comeback.example.com
